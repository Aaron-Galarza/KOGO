# Opcional: ubicación del local (por defecto la de KOGO, Corrientes).
STORE_LAT=
STORE_LNG=
# Opcional: topes mensuales para no salir de la capa gratuita.
GOOGLE_GEOCODE_MONTHLY_CAP=
GOOGLE_ROUTES_MONTHLY_CAP=
